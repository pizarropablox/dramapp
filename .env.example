# Copy this file to .env and adjust the values for your machine.
# .env is git-ignored; never commit real credentials.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=dramapp
POSTGRES_PASSWORD=dramapp

# Login users for local development (spring-boot:run reads this file). {noop} = plain text, only accepted
# outside the prod profile. Without them nobody can log in locally. Pick your own local passwords.
DRAMAPP_BARRA_PASSWORD={noop}cambia-esta-clave-local
DRAMAPP_ADMIN_PASSWORD={noop}cambia-esta-otra-clave-local
# Optional locally: without it the backend signs with a random key and sessions end when it restarts.
# DRAMAPP_JWT_SECRET=

# Production (set in Render's dashboard, never here). Names only, see README > Deploy:
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=       Neon direct connection as JDBC, with sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# DRAMAPP_JWT_SECRET=          base64, 256 bits
# DRAMAPP_BARRA_PASSWORD=      {bcrypt}$2y$10$...
# DRAMAPP_ADMIN_PASSWORD=      {bcrypt}$2y$10$...
