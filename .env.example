# Copy this file to .env and adjust the values for your machine.
# .env is git-ignored; never commit real credentials.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=dramapp
POSTGRES_PASSWORD=dramapp

# Production (set in Render's dashboard, never here). Names only, see README > Deploy:
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=       Neon direct connection as JDBC, with sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
